# Math Learning Application Configuration
# Copy this file to .env and update with your actual values

# =============================================================================
# API Keys
# =============================================================================
# OpenAI API Key for GPT models
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key for Claude models
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================================
# Database Configuration
# =============================================================================
# Qdrant Vector Database
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Neo4j Graph Database
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# =============================================================================
# GPU Configuration
# =============================================================================
# Which GPU to use (0 for first GPU, or 0,1 for multiple)
CUDA_VISIBLE_DEVICES=0

# PyTorch CUDA memory allocation configuration
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512,expandable_segments:True

# =============================================================================
# Application Settings
# =============================================================================
# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Number of worker processes for API server
WORKERS=4

# Number of threads per worker
THREADS=2

# API host and port
HOST=0.0.0.0
PORT=8000

# =============================================================================
# Model Cache Settings
# =============================================================================
# These are automatically set in docker-compose, but can be overridden
# TRANSFORMERS_CACHE=/app/math_learning/cache
# HF_HOME=/app/math_learning/cache
# SENTENCE_TRANSFORMERS_HOME=/app/math_learning/cache

# =============================================================================
# Advanced GPU Settings (Optional)
# =============================================================================
# Set GPU clock speed (requires nvidia-smi with appropriate permissions)
# GPU_CLOCK_SPEED=2100

# Enable TensorFloat-32 for faster training on Ampere GPUs
# NVIDIA_TF32_OVERRIDE=1

# Mixed precision training
# MIXED_PRECISION=fp16
