    {
      "id": "GEO-912-006",
      "title": "Law of Sines",
      "problem": "In triangle ABC, angle A = 30°, angle B = 45°, and side a = 10. Find side b.",
      "solution": "14.14",
      "difficulty": 5,
      "estimated_time": 8,
      "grade_level": "9-12",
      "format_type": "calculation",
      "concepts": [
        "trigonometry",
        "law_of_sines",
        "triangles"
      ],
      "hints": [
        "a/sin(A) = b/sin(B)",
        "10/sin(30°) = b/sin(45°)",
        "sin(30°) = 0.5, sin(45°) ≈ 0.707"
      ]
    }
