      "title": "Circle Theorems",
      "problem": "If an inscribed angle intercepts an arc of 80°, what is the measure of the inscribed angle?",
      "solution": "40°",
      "difficulty": 4,
      "estimated_time": 5,
      "grade_level": "9-12",
      "format_type": "calculation",
      "concepts": [
        "circles",
        "inscribed_angles",
        "arc_measures"
      ],
      "hints": [
        "Inscribed angle = ½ × intercepted arc",
        "Arc = 80°",
        "80° ÷ 2 = 40°"
      ]
    },
